# OS
.DS_Store
Thumbs.db

# IDE config locale (.vibe = agents/skills custom IDE-side)
.vibe/

# Logs
*.log

# Node (legacy prototype)
node_modules/
dist/

# .NET build outputs
bin/
obj/
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# Test results
TestResults/
*.trx
*.coverage
coverage/

# Rider / VS Code
.idea/
.vscode/

# Claude Code local state — on versionne les skills (workflow équipe + harnais),
# mais pas les settings locaux ni l'état IDE perso.
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
.claude/cache/
.claude/conversations/
.claude/agents/
.claude/*.log

# Certificats (clé privée) — jamais commiter
*.pfx
pfx-base64.txt

# Secrets env (API tokens, etc.) — toujours hors repo
*.env
.env.*
!*.env.example

# Cloudflare local state (caches + miniflare state, regenerated à la volée)
.wrangler/

# Stats locales (HTML généré par tools/cloudflare/stats.sh html — privé, jamais commiter)
stats-local/

# Artifacts de build installer (regenerables via adapter-vsto/installer/build.ps1 ;
# les .exe finaux sont hébergés sur R2, pas sur git)
adapter-vsto/installer/payload/
adapter-vsto/installer/output/
adapter-vsto/installer/after-install.txt
# VC++ Redist téléchargé localement par build.ps1 (regenerable, ~25 Mo)
adapter-vsto/installer/vc_redist.x64.exe
adapter-vsto/installer/vc_redist.x86.exe

# PNG sortis par les tests probe WpfMath / MixedLatexRenderer (régénérables
# via dotnet test, voir adapter-vsto/tests/MathCursor.Tests/UI/).
.render-probes/

# Output intermédiaire de `dotnet publish` du projet WASM démo. Le bundle
# final est mirroré dans docs/demo/ (qui lui est commit pour Pages deploy).
web-demo/publish/

# Modèle ML — gros fichiers binaires, distribués hors git
models/
*.onnx
*.bpe.model

# Local reports dump (screenshots utilisateur, ne pas committer)
reports-local/

# Python cache
__pycache__/
*.pyc
docs/dev/decisions/GladiatorSurvivor/
