<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MathCursor.Tests</RootNamespace>
    <AssemblyName>MathCursor.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- WPF pour les probe tests WpfMath (FormulaControl hors Word). STA via UI/StaRunner.cs. -->
    <UseWPF>true</UseWPF>
    <!-- x64 pour ONNX Runtime (natif x64 only en 1.16.3 pinné, ADR Bay Trail). -->
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Natives ONNX copiées à côté de l'assembly (pas auto sur net48 + SDK csproj). -->
  <Target Name="CopyOnnxRuntimeNatives" AfterTargets="Build">
    <ItemGroup>
      <_OnnxNativeFiles Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.16.3\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OnnxNativeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ONNX pinné 1.16.3 (ADR 2026-04-28-Fix-ort-version-bay-trail-compat). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.16.3" />
    <!-- OnnxRuntime 1.16.3 a besoin d'Unsafe 6.0.0 sur net48. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.runner.json : désactive le shadow-copy (sinon les natives
         onnxruntime.dll ne sont pas résolues). -->
    <None Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Sources adapter testées : compilation directe (le csproj VSTO requiert
         MSBuild Office Tools, qu'on ne veut pas comme prérequis du test runner).
         Tous les fichiers liés ici sont pure compute (pas de Word interop). -->
    <Compile Include="..\..\src\MathCursor\UI\WpfMathAdapter.cs" Link="adapter-sources\UI\WpfMathAdapter.cs" />
    <Compile Include="..\..\src\MathCursor\UI\MixedLatexRenderer.cs" Link="adapter-sources\UI\MixedLatexRenderer.cs" />
    <Compile Include="..\..\src\MathCursor\Detection\DetectedZone.cs" Link="adapter-sources\Detection\DetectedZone.cs" />
    <Compile Include="..\..\src\MathCursor\Detection\WordPiece\WordPieceTokenizer.cs" Link="adapter-sources\Detection\WordPiece\WordPieceTokenizer.cs" />
    <Compile Include="..\..\src\MathCursor\Detection\MathNerDetector.cs" Link="adapter-sources\Detection\MathNerDetector.cs" />
    <Compile Include="..\..\src\MathCursor\Host\AutocorrectNormalizer.cs" Link="adapter-sources\Host\AutocorrectNormalizer.cs" />
    <Compile Include="..\..\src\MathCursor\Host\Detection\NerInputWindow.cs" Link="adapter-sources\Host\Detection\NerInputWindow.cs" />
    <Compile Include="..\..\src\MathCursor\Host\Detection\ZoneRefiner.cs" Link="adapter-sources\Host\Detection\ZoneRefiner.cs" />
    <Compile Include="..\..\src\MathCursor\Host\ParagraphTextExtractor.cs" Link="adapter-sources\Host\ParagraphTextExtractor.cs" />
  </ItemGroup>

</Project>
