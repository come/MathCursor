<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <!--
        Onglet Accueil (TabHome) : duo immédiat utile (cf. ADR
        2026-05-11-Feat-ribbon-home-duo-plus-dedicated-tab). Convertir +
        Colonnes seulement, le reste va dans l'onglet dédié MathCursor.
        Icônes PNG embarquées via getImage="OnGetButtonImage" (sources
        SVG dans tools/icons/ribbon/, rasterisation par
        tools/icons/rasterize-ribbon-icons.ps1).
      -->
      <tab idMso="TabHome">
        <group id="MathCursorHomeGroup" getLabel="OnGetHomeGroupLabel">
          <menu id="ColumnsHomeMenu"
                getLabel="OnGetColumnsMenuLabel"
                getScreentip="OnGetColumnsMenuScreentip"
                size="large"
                getImage="OnGetButtonImage">
            <button id="InsertColumns1Button"
                    getLabel="OnGetColumns1Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns2Button"
                    getLabel="OnGetColumns2Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns3Button"
                    getLabel="OnGetColumns3Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns4Button"
                    getLabel="OnGetColumns4Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
          </menu>
        </group>
      </tab>

      <!-- Onglet dédié MathCursor : galerie complète (cf. ADR 2026-05-11). -->
      <tab id="MathCursorTab" getLabel="OnGetMathCursorTabLabel">
        <!-- Groupe Saisie -->
        <group id="MathCursorInputGroup" getLabel="OnGetInputGroupLabel">
          <button id="CheatsheetButton"
                  getLabel="OnGetCheatsheetButtonLabel"
                  getScreentip="OnGetCheatsheetButtonScreentip"
                  getEnabled="OnGetCheatsheetEnabled"
                  size="large"
                  getImage="OnGetButtonImage"
                  onAction="OnCheatsheetClicked" />
        </group>

        <!-- Groupe Mise en page -->
        <group id="MathCursorLayoutGroup" getLabel="OnGetLayoutGroupLabel">
          <menu id="ColumnsTabMenu"
                getLabel="OnGetColumnsMenuLabel"
                getScreentip="OnGetColumnsMenuScreentip"
                size="large"
                getImage="OnGetButtonImage">
            <button id="InsertColumns1TabButton"
                    getLabel="OnGetColumns1Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns2TabButton"
                    getLabel="OnGetColumns2Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns3TabButton"
                    getLabel="OnGetColumns3Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns4TabButton"
                    getLabel="OnGetColumns4Label"
                    getImage="OnGetButtonImage"
                    onAction="OnInsertColumnsClicked" />
          </menu>
        </group>

        <!-- Groupe Constructions (roadmap, boutons grisés) -->
        <group id="MathCursorConstructionsGroup" getLabel="OnGetConstructionsGroupLabel">
          <button id="ConstructionSignTableButton"
                  getLabel="OnGetConstructionSignTableLabel"
                  getScreentip="OnGetConstructionComingSoonScreentip"
                  getEnabled="OnGetConstructionEnabled"
                  size="normal"
                  getImage="OnGetButtonImage" />
          <button id="ConstructionVariationTableButton"
                  getLabel="OnGetConstructionVariationTableLabel"
                  getScreentip="OnGetConstructionComingSoonScreentip"
                  getEnabled="OnGetConstructionEnabled"
                  size="normal"
                  getImage="OnGetButtonImage" />
          <button id="ConstructionCurveButton"
                  getLabel="OnGetConstructionCurveLabel"
                  getScreentip="OnGetConstructionComingSoonScreentip"
                  getEnabled="OnGetConstructionEnabled"
                  size="normal"
                  getImage="OnGetButtonImage" />
          <button id="ConstructionFigureButton"
                  getLabel="OnGetConstructionFigureLabel"
                  getScreentip="OnGetConstructionComingSoonScreentip"
                  getEnabled="OnGetConstructionEnabled"
                  size="normal"
                  getImage="OnGetButtonImage" />
        </group>

        <!-- Groupe Outils -->
        <group id="MathCursorToolsTabGroup" getLabel="OnGetToolsTabGroupLabel">
          <button id="SettingsButton"
                  getLabel="OnGetSettingsButtonLabel"
                  getScreentip="OnGetSettingsButtonScreentip"
                  size="normal"
                  getImage="OnGetButtonImage"
                  onAction="OnSettingsClicked" />
          <button id="ReportIssueTabButton"
                  getLabel="OnGetReportButtonLabel"
                  getScreentip="OnGetReportButtonScreentip"
                  size="normal"
                  getImage="OnGetButtonImage"
                  onAction="OnReportIssueClicked" />
          <button id="ContextInspectorTabButton"
                  getLabel="OnGetContextInspectorButtonLabel"
                  getScreentip="OnGetContextInspectorButtonScreentip"
                  size="normal"
                  getImage="OnGetButtonImage"
                  onAction="OnContextInspectorClicked" />
          <button id="DebugInsertOMathButton"
                  label="Debug : f(x)=1"
                  screentip="Insère une OMath simple f(x)=1 au curseur et place le caret à la fin. Outil de test pour isoler les bugs d'insertion sans passer par NER/popup."
                  size="normal"
                  onAction="OnDebugInsertOMathClicked" />
          <button id="DebugReplaceByOMathButton"
                  label="Debug : replace → f(x)=1"
                  screentip="Replace la sélection (ou les 6 chars avant le caret) par une OMath f(x)=1 alignée à gauche. Simule la recette minimale post-popup : range.Text = unicodeMath + OMaths.Add + BuildUp + om.Justification, sans toucher au caret."
                  size="normal"
                  onAction="OnDebugReplaceByOMathClicked" />
          <button id="DebugWrapOMathInCCButton"
                  label="POC : wrap OMath en CC"
                  screentip="POC ContentControl-based metadata. Prend l'OMath collée au caret (probe doc.Range(caret-1,caret).OMaths), l'enveloppe dans un CC Hidden avec Title=MathCursor + Tag JSON (steno/latex/hash/version). Test du backlink O(1) via ParentContentControl."
                  size="normal"
                  onAction="OnDebugWrapOMathInCCClicked" />
          <button id="DebugReadCCAtCaretButton"
                  label="POC : read CC at caret"
                  screentip="POC lecture. Affiche dans le pane debug ce que renvoie om.Range.ParentContentControl pour l'OMath collée au caret, et le contenu JSON parsé de cc.Tag. Vérifie que le backlink natif fonctionne."
                  size="normal"
                  onAction="OnDebugReadCCAtCaretClicked" />
          <button id="DebugInsertWrappedOMathButton"
                  label="POC : insert g(x)=2 wrappé"
                  screentip="POC full flow. Insère g(x)=2 au caret (TypeText + OMaths.Add + BuildUp + Justification.Left) ET enveloppe atomiquement dans un CC MathCursor avec Tag JSON (steno, latex, hash post-wrap). Simule ce que la Phase B/C fera dans InsertOMathAt."
                  size="normal"
                  onAction="OnDebugInsertWrappedOMathClicked" />
          <button id="DebugCleanupOrphanCCsButton"
                  label="POC : cleanup orphan CCs"
                  screentip="Scanne doc.ContentControls et liste les CCs MathCursor sans OMath dedans (= orphelins fantômes). Affiche le diag dans le pane + supprime les orphelins trouvés."
                  size="normal"
                  onAction="OnDebugCleanupOrphanCCsClicked" />
          <button id="DebugStepStartButton"
                  label="POC Step : start [=1]"
                  screentip="Capture la sélection courante comme zone d'insertion, source = '=1', latex = '= 1'. Réinit le step runner. Sélectionne ton '=1' plain text dans le doc avant de cliquer."
                  size="normal"
                  onAction="OnDebugStepStartClicked" />
          <button id="DebugStepNextButton"
                  label="POC Step : next"
                  screentip="Avance d'une étape dans la séquence d'InsertOMathAt. Affiche dans le pane debug l'état du doc après l'étape. Cycle : Normalize → SetRange → Delete → TypeText → CC wrap → OMath build → Tag → CcSticky."
                  size="normal"
                  onAction="OnDebugStepNextClicked" />
          <button id="DebugDumpCharPositionsButton"
                  label="POC : dump char positions"
                  screentip="Itère paragraph.Range.Characters du ¶ courant et dump pour chaque char : Range.Start, Range.End, Range.Text (escapé). Sert à valider si Word.Characters[i].Start = position interne du char visible i (= alternative au translator string→internal)."
                  size="normal"
                  onAction="OnDebugDumpCharPositionsClicked" />
          <button id="DebugProbeLeftNeighborButton"
                  label="POC : probe left neighbor"
                  screentip="Sonde tous les chemins de détection « voisin gauche OMath » au caret : ParentContentControl à 5 positions autour, doc.Range(p,p+1).OMaths sur 5 positions, NeighborFinder.FindAdjacent, IntraOMathsMerger.TryMergeWithLeft simulé avec source='=1'. Affiche dans l'inspecteur ce que chaque probe retourne sans rien modifier."
                  size="normal"
                  onAction="OnDebugProbeLeftNeighborClicked" />
          <button id="AboutButton"
                  getLabel="OnGetAboutButtonLabel"
                  getScreentip="OnGetAboutButtonScreentip"
                  size="normal"
                  getImage="OnGetButtonImage"
                  onAction="OnAboutClicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
