<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ribbon Phase 2 beta-clean (ADR 2026-06-10-Refactor-phase2-adapter-orchestration-rewrite).
  Un seul onglet, icônes imageMso natives (pas de PNG embarqués).
  Disparus : groupe TabHome, constructions, cheatsheet, inspector, POC debug.
  Colonnes + Paramètres restaurés ici UNIQUEMENT — pas de retour TabHome
  (ADR 2026-06-10-Feat-ribbon-columns-settings-culture).
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="MathCursorTab" getLabel="OnGetTabLabel">
        <group id="MathCursorConversionGroup" getLabel="OnGetConversionGroupLabel">
          <button id="ConvertButton"
                  getLabel="OnGetConvertButtonLabel"
                  getScreentip="OnGetConvertButtonScreentip"
                  size="large"
                  imageMso="EquationInsertNew"
                  onAction="OnConvertClicked" />
          <!-- Toggle détection auto (= AppSettings.AutoDetect, même switch que
               la case des Paramètres). Off = plus de popup spontanée (cours
               d'histoire...), Ctrl+Espace reste actif. -->
          <toggleButton id="AutoDetectToggle"
                        getLabel="OnGetAutoDetectToggleLabel"
                        getScreentip="OnGetAutoDetectToggleScreentip"
                        getPressed="OnGetAutoDetectPressed"
                        size="large"
                        imageMso="ControlWizards"
                        onAction="OnAutoDetectToggled" />
          <!-- Toggle « Tab valide » (= AppSettings.TabValidate, défaut OFF) :
               actif, Tab commit le candidat sélectionné popup ouverte (sans
               propager la tabulation). Cf. ADR 2026-06-10-UX-tab-validate-toggle. -->
          <toggleButton id="TabValidateToggle"
                        getLabel="OnGetTabValidateToggleLabel"
                        getScreentip="OnGetTabValidateToggleScreentip"
                        getPressed="OnGetTabValidatePressed"
                        size="normal"
                        imageMso="AcceptTask"
                        onAction="OnTabValidateToggled" />
          <!-- Encadre l'équation sous le caret (\boxed → m:borderBox), via le
               pipeline d'insertion (1 Ctrl+Z annule). Cf. ADR 2026-06-20. -->
          <button id="BoxResultButton"
                  getLabel="OnGetBoxResultButtonLabel"
                  getScreentip="OnGetBoxResultButtonScreentip"
                  size="normal"
                  imageMso="BorderOutside"
                  onAction="OnBoxResultClicked" />
        </group>
        <group id="MathCursorLayoutGroup" getLabel="OnGetLayoutGroupLabel">
          <menu id="ColumnsMenu"
                getLabel="OnGetColumnsMenuLabel"
                getScreentip="OnGetColumnsMenuScreentip"
                size="large"
                imageMso="ColumnsDialog">
            <button id="InsertColumns1Button"
                    getLabel="OnGetColumns1Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns2Button"
                    getLabel="OnGetColumns2Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns3Button"
                    getLabel="OnGetColumns3Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns4Button"
                    getLabel="OnGetColumns4Label"
                    onAction="OnInsertColumnsClicked" />
          </menu>
          <!-- Encadrés colorés typés (Théorème/Définition/Exemple/Propriété) :
               style de paragraphe Word (barre d'accent + fond + titre), aucune
               OMath. Cf. ADR 2026-06-20-Feat-encadres-callouts-boxed. -->
          <menu id="CalloutMenu"
                getLabel="OnGetCalloutMenuLabel"
                getScreentip="OnGetCalloutMenuScreentip"
                size="large"
                imageMso="TextBoxInsert">
            <button id="CalloutTheoremButton"
                    getLabel="OnGetCalloutTheoremLabel"
                    onAction="OnInsertCalloutClicked" />
            <button id="CalloutDefinitionButton"
                    getLabel="OnGetCalloutDefinitionLabel"
                    onAction="OnInsertCalloutClicked" />
            <button id="CalloutExampleButton"
                    getLabel="OnGetCalloutExampleLabel"
                    onAction="OnInsertCalloutClicked" />
            <button id="CalloutPropertyButton"
                    getLabel="OnGetCalloutPropertyLabel"
                    onAction="OnInsertCalloutClicked" />
          </menu>
        </group>
        <group id="MathCursorToolsGroup" getLabel="OnGetToolsGroupLabel">
          <!-- Sélecteur de police math (Cambria / Latin Modern / STIX). Au
               choix : pose la fonte sur TOUTES les équations du doc + mémorise
               le préréglage des futures insertions MathCursor. Liste curatée
               (fontes à table OpenType MATH). Cf. ADR 2026-06-22-Feat-math-font-selector. -->
          <dropDown id="MathFontDropDown"
                    getLabel="OnGetMathFontLabel"
                    getScreentip="OnGetMathFontScreentip"
                    getItemCount="OnGetMathFontItemCount"
                    getItemID="OnGetMathFontItemId"
                    getItemLabel="OnGetMathFontItemLabel"
                    getSelectedItemIndex="OnGetMathFontSelectedIndex"
                    onAction="OnMathFontSelected" />
          <button id="SettingsButton"
                  getLabel="OnGetSettingsButtonLabel"
                  getScreentip="OnGetSettingsButtonScreentip"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnSettingsClicked" />
        </group>
        <group id="MathCursorHelpGroup" getLabel="OnGetHelpGroupLabel">
          <button id="ReportIssueButton"
                  getLabel="OnGetReportButtonLabel"
                  getScreentip="OnGetReportButtonScreentip"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnReportIssueClicked" />
          <!-- Réouvre le docx tutoriel installé dans Documents\MathCursor\
               (nom universel FR/EN, cf. MathCursor.iss + ADR 2026-05-22). -->
          <button id="OpenTutorialButton"
                  getLabel="OnGetTutorialButtonLabel"
                  getScreentip="OnGetTutorialButtonScreentip"
                  size="normal"
                  imageMso="FileOpen"
                  onAction="OnOpenTutorialClicked" />
          <button id="AboutButton"
                  getLabel="OnGetAboutButtonLabel"
                  getScreentip="OnGetAboutButtonScreentip"
                  size="normal"
                  imageMso="Info"
                  onAction="OnAboutClicked" />
        </group>
        <!-- Groupe « Mise à jour » : le GROUPE entier est caché par défaut et
             n'apparaît (getVisible) que quand UpdateChecker détecte une version
             plus récente — placé tout à droite pour être bien visible.
             Cf. ADR 2026-06-18-Feat-ribbon-update-badge. -->
        <group id="MathCursorUpdateGroup"
               getLabel="OnGetUpdateGroupLabel"
               getVisible="OnGetUpdateGroupVisible">
          <button id="UpdateButton"
                  getLabel="OnGetUpdateButtonLabel"
                  getScreentip="OnGetUpdateButtonScreentip"
                  size="large"
                  getImage="OnGetUpdateButtonImage"
                  onAction="OnUpdateClicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
