<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ribbon Phase 2 beta-clean (ADR 2026-06-10-Refactor-phase2-adapter-orchestration-rewrite).
  Un seul onglet, icônes imageMso natives (pas de PNG embarqués).
  Disparus : groupe TabHome, constructions, cheatsheet, inspector, POC debug.
  Colonnes + Paramètres restaurés ici UNIQUEMENT — pas de retour TabHome
  (ADR 2026-06-10-Feat-ribbon-columns-settings-culture).
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="MathCursorTab" getLabel="OnGetTabLabel">
        <group id="MathCursorConversionGroup" getLabel="OnGetConversionGroupLabel">
          <button id="ConvertButton"
                  getLabel="OnGetConvertButtonLabel"
                  getScreentip="OnGetConvertButtonScreentip"
                  size="large"
                  imageMso="EquationInsertNew"
                  onAction="OnConvertClicked" />
        </group>
        <group id="MathCursorLayoutGroup" getLabel="OnGetLayoutGroupLabel">
          <menu id="ColumnsMenu"
                getLabel="OnGetColumnsMenuLabel"
                getScreentip="OnGetColumnsMenuScreentip"
                size="large"
                imageMso="ColumnsDialog">
            <button id="InsertColumns1Button"
                    getLabel="OnGetColumns1Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns2Button"
                    getLabel="OnGetColumns2Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns3Button"
                    getLabel="OnGetColumns3Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns4Button"
                    getLabel="OnGetColumns4Label"
                    onAction="OnInsertColumnsClicked" />
          </menu>
        </group>
        <group id="MathCursorToolsGroup" getLabel="OnGetToolsGroupLabel">
          <button id="SettingsButton"
                  getLabel="OnGetSettingsButtonLabel"
                  getScreentip="OnGetSettingsButtonScreentip"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnSettingsClicked" />
        </group>
        <!-- POC M0 multiligne (temporaire, à retirer une fois A/B tranché). -->
        <group id="MathCursorPocGroup" label="POC">
          <button id="PocChainTableButton"
                  label="POC chaîne (tableau)"
                  screentip="Insère un tableau invisible 2 colonnes avec 3 équations alignées au signe (option B du chantier multiligne). Sert au script de torture : suppression de lignes, Backspace aux bords, tableau fantôme, Ctrl+Z."
                  size="normal"
                  imageMso="TableInsert"
                  onAction="OnPocChainTableClicked" />
          <button id="PocChainEqArrButton"
                  label="POC chaîne (eqArr)"
                  screentip="Insère la MÊME chaîne en UN SEUL OMath multiligne (equation array natif, alignement &amp; au signe — option A-discipliné). Comparer le feel de modification avec le POC tableau : Backspace (bloc atomique), clic dedans (édition native), Ctrl+Z."
                  size="normal"
                  imageMso="EquationLinearFormat"
                  onAction="OnPocChainEqArrClicked" />
          <menu id="PocUndoMenu"
                label="POC undo"
                screentip="Banc d'essai groupage undo : chaque variante insère « avant [x=1/2] après » dans un custom record. Protocole : cliquer, faire UN Ctrl+Z, vérifier que tout disparaît, lire le log (sondes IsRecordingCustomRecord)."
                size="normal"
                imageMso="Undo">
            <button id="PocUndo1Button" label="V1 — InsertXML direct (témoin cassé)" onAction="OnPocUndoClicked" />
            <button id="PocUndo2Button" label="V2 — TypeText + BuildUp (témoin OK)" onAction="OnPocUndoClicked" />
            <button id="PocUndo3Button" label="V3 — Ghost doc + FormattedText" onAction="OnPocUndoClicked" />
            <button id="PocUndo4Button" label="V4 — OMaths.Add + Functions.Add" onAction="OnPocUndoClicked" />
          </menu>
          <button id="PocWalkerConformanceButton"
                  label="POC walker (conformance)"
                  screentip="Batterie LaTeX → walker OMML→OMath → relecture WordOpenXML → comparaison normalisée. Rapport PASS/DIFF/FALLBACK au log. À lancer dans un doc de test (insère/supprime en fin de doc)."
                  size="normal"
                  imageMso="ReviewCompareTwoVersions"
                  onAction="OnPocWalkerConformanceClicked" />
        </group>
        <group id="MathCursorHelpGroup" getLabel="OnGetHelpGroupLabel">
          <button id="ReportIssueButton"
                  getLabel="OnGetReportButtonLabel"
                  getScreentip="OnGetReportButtonScreentip"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnReportIssueClicked" />
          <button id="AboutButton"
                  getLabel="OnGetAboutButtonLabel"
                  getScreentip="OnGetAboutButtonScreentip"
                  size="normal"
                  imageMso="Info"
                  onAction="OnAboutClicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
