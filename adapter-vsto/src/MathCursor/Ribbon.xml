<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <!--
        Group MathCursor placé dans l'onglet Accueil de Word (cf. ADR
        2026-05-06-Feat-ribbon-pane-examples-pivot, qui supersede 2026-05-05).
        Onglet dédié écarté car visuellement vide (2 boutons), pivot vers
        intégration discrète dans TabHome.
      -->
      <tab idMso="TabHome">
        <group id="MathCursorToolsGroup" getLabel="OnGetToolsGroupLabel">
          <!-- Bouton Cheatsheet retiré temporairement : le pane planté en
               l'état (refonte galerie d'exemples en cours, cf. ADR
               2026-05-06-Feat-ribbon-pane-examples-pivot). Réintégrer en
               "Exemples" quand la refonte sera livrée. Icône mortier
               préservée dans Resources/cheatsheet{16,32}.png + script de
               régénération dans tools/icons/. -->
          <button id="ReportIssueButton"
                  getLabel="OnGetReportButtonLabel"
                  getScreentip="OnGetReportButtonScreentip"
                  size="large"
                  imageMso="WarningOriginal"
                  onAction="OnReportIssueClicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
