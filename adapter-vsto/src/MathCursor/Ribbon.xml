<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ribbon Phase 2 beta-clean (ADR 2026-06-10-Refactor-phase2-adapter-orchestration-rewrite).
  Un seul onglet, icônes imageMso natives (pas de PNG embarqués).
  Disparus : groupe TabHome, constructions, cheatsheet, inspector, POC debug.
  Colonnes + Paramètres restaurés ici UNIQUEMENT — pas de retour TabHome
  (ADR 2026-06-10-Feat-ribbon-columns-settings-culture).
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="MathCursorTab" getLabel="OnGetTabLabel">
        <group id="MathCursorConversionGroup" getLabel="OnGetConversionGroupLabel">
          <button id="ConvertButton"
                  getLabel="OnGetConvertButtonLabel"
                  getScreentip="OnGetConvertButtonScreentip"
                  size="large"
                  imageMso="EquationInsertNew"
                  onAction="OnConvertClicked" />
          <!-- Toggle détection auto (= AppSettings.AutoDetect, même switch que
               la case des Paramètres). Off = plus de popup spontanée (cours
               d'histoire...), Ctrl+Espace reste actif. -->
          <toggleButton id="AutoDetectToggle"
                        getLabel="OnGetAutoDetectToggleLabel"
                        getScreentip="OnGetAutoDetectToggleScreentip"
                        getPressed="OnGetAutoDetectPressed"
                        size="large"
                        imageMso="ControlWizards"
                        onAction="OnAutoDetectToggled" />
          <!-- Toggle « Tab valide » (= AppSettings.TabValidate, défaut OFF) :
               actif, Tab commit le candidat sélectionné popup ouverte (sans
               propager la tabulation). Cf. ADR 2026-06-10-UX-tab-validate-toggle. -->
          <toggleButton id="TabValidateToggle"
                        getLabel="OnGetTabValidateToggleLabel"
                        getScreentip="OnGetTabValidateToggleScreentip"
                        getPressed="OnGetTabValidatePressed"
                        size="normal"
                        imageMso="AcceptTask"
                        onAction="OnTabValidateToggled" />
        </group>
        <group id="MathCursorLayoutGroup" getLabel="OnGetLayoutGroupLabel">
          <menu id="ColumnsMenu"
                getLabel="OnGetColumnsMenuLabel"
                getScreentip="OnGetColumnsMenuScreentip"
                size="large"
                imageMso="ColumnsDialog">
            <button id="InsertColumns1Button"
                    getLabel="OnGetColumns1Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns2Button"
                    getLabel="OnGetColumns2Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns3Button"
                    getLabel="OnGetColumns3Label"
                    onAction="OnInsertColumnsClicked" />
            <button id="InsertColumns4Button"
                    getLabel="OnGetColumns4Label"
                    onAction="OnInsertColumnsClicked" />
          </menu>
        </group>
        <group id="MathCursorToolsGroup" getLabel="OnGetToolsGroupLabel">
          <button id="SettingsButton"
                  getLabel="OnGetSettingsButtonLabel"
                  getScreentip="OnGetSettingsButtonScreentip"
                  size="large"
                  imageMso="ApplicationOptionsDialog"
                  onAction="OnSettingsClicked" />
        </group>
        <!-- POC hash-source-map (ADR 2026-06-11-Feat-hash-source-map-no-cc) :
             sondes G1-G6, groupe TEMPORAIRE à retirer après verdict. -->
        <group id="MathCursorPocGroup" label="POC hash (debug)">
          <button id="PocBaselineButton" label="P1a baseline"
                  screentip="Insère g(x)=1/x via le pipeline ACTUEL (ZWSP+CC+Tag), timing au log. Cliquer 10× pour la médiane (G4)."
                  size="normal" imageMso="MacroPlay" onAction="OnPocBaselineClicked" />
          <button id="PocNoAnchorButton" label="P1b sans anchor"
                  screentip="Insère g(x)=1/x SANS ZWSP ni CC, source en map CustomXMLParts. Timings par étape + type Display/Inline au log (G4/G5)."
                  size="normal" imageMso="MacroPlay" onAction="OnPocNoAnchorClicked" />
          <button id="PocUltraLeanButton" label="P1d ultra-léger"
                  screentip="Comme P1b mais Delete simple au lieu de ZoneCleaner (chemin nominal : zone = texte vierge). Timing comparé."
                  size="normal" imageMso="MacroPlay" onAction="OnPocUltraLeanClicked" />
          <button id="PocUltraLeanFrozenButton" label="P1e ultra + gelé"
                  screentip="P1d + ScreenUpdating=false pendant la séquence : aucune étape visible, que l'état final. La cible « envoi instantané »."
                  size="normal" imageMso="MacroPlay" onAction="OnPocUltraLeanFrozenClicked" />
          <button id="PocBaselineFrozenButton" label="P1f baseline gelé"
                  screentip="Pipeline ACTUEL + écran gelé : isole le jank visuel. Si la fluidité perçue vient de là, ce levier est shippable sans bascule."
                  size="normal" imageMso="MacroPlay" onAction="OnPocBaselineFrozenClicked" />
          <button id="PocEqArrButton" label="P1c eqArr nu"
                  screentip="Bloc eqArr 3 lignes sans anchor (POC existant) — vérifier l'alignement &amp; en display (G5)."
                  size="normal" imageMso="MacroPlay" onAction="OnPocEqArrClicked" />
          <button id="PocSnapshotButton" label="P2 snapshot"
                  screentip="Snapshot K1/K2 de toutes les OMaths du doc (persisté dans le docx) + timings Range.Text vs WordOpenXML."
                  size="normal" imageMso="Camera" onAction="OnPocSnapshotClicked" />
          <button id="PocVerifyButton" label="P3 vérif drift"
                  screentip="Recompare les OMaths aux snapshots. À rejouer après : frappe ailleurs, caret dedans, save+reopen, copy-paste (G1/G2)."
                  size="normal" imageMso="ReviewTrackChanges" onAction="OnPocVerifyClicked" />
          <button id="PocDiscriminationButton" label="P4 discrimination"
                  screentip="Insère les paires piégeuses (x² vs x₂, frac vs linéaire…) : collisions K1, départage K2 (G3)."
                  size="normal" imageMso="Repeat" onAction="OnPocDiscriminationClicked" />
          <button id="PocPartButton" label="P5 part roundtrip"
                  screentip="Write/read 100 entrées en CustomXMLPart : timing + record undo intact (G6)."
                  size="normal" imageMso="SaveAll" onAction="OnPocPartClicked" />
        </group>
        <group id="MathCursorHelpGroup" getLabel="OnGetHelpGroupLabel">
          <button id="ReportIssueButton"
                  getLabel="OnGetReportButtonLabel"
                  getScreentip="OnGetReportButtonScreentip"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnReportIssueClicked" />
          <!-- Réouvre le docx tutoriel installé dans Documents\MathCursor\
               (nom universel FR/EN, cf. MathCursor.iss + ADR 2026-05-22). -->
          <button id="OpenTutorialButton"
                  getLabel="OnGetTutorialButtonLabel"
                  getScreentip="OnGetTutorialButtonScreentip"
                  size="normal"
                  imageMso="FileOpen"
                  onAction="OnOpenTutorialClicked" />
          <button id="AboutButton"
                  getLabel="OnGetAboutButtonLabel"
                  getScreentip="OnGetAboutButtonScreentip"
                  size="normal"
                  imageMso="Info"
                  onAction="OnAboutClicked" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
