<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Trim OFF : le DTO (DemoResult/DemoCand) et les méthodes [JSInvokable]
         sont atteints par RÉFLEXION (JS-interop + System.Text.Json), que le
         trimmer couperait. Le moteur est minuscule ; le poids du bundle, c'est
         le runtime .NET de toute façon. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Compression Brotli/gzip des assets _framework au publish. -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- LE moteur de reconnaissance (forest) — pur, netstandard2.0, zéro
         dépendance. C'est exactement le même Analyze que la version Word. -->
    <ProjectReference Include="..\..\engine\src\MathCursor.Engine\MathCursor.Engine.csproj" />
  </ItemGroup>

</Project>
