<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Trimming désactivé : core-csharp utilise YamlDotNet (réflexion) pour
         charger les YAML domains. Le trimmer agressif de Blazor WASM casse
         ça sinon. Coût : ~2 Mo de bundle en plus, acceptable pour une démo. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Bundle compression Brotli côté Cloudflare Pages. -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference vers core-csharp — pas de modif, juste réutilisation. -->
    <ProjectReference Include="..\..\core-csharp\src\MathCursor.Core\MathCursor.Core.csproj" />
  </ItemGroup>

</Project>
