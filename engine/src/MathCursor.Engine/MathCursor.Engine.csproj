<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>MathCursor.Engine</RootNamespace>
    <AssemblyName>MathCursor.Engine</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Description>MathCursor recognition engine — portage C# du moteur web `forest` (grammaire ambiguë → forêt → classement → LaTeX). Pur, host-agnostic. Cf. PLAN.md §3.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests de tolérance sur corpus : accès à Vocabulary/EngineCulture.Aliases
         pour filtrer les fixtures qui commencent par un mot-clé. -->
    <InternalsVisibleTo Include="MathCursor.Engine.Tests" />
  </ItemGroup>

  <!-- Data universelle du moteur (source unique partagée avec le port Python),
       embarquée avec un LogicalName stable lu par EngineData.Load. Cf. ADR
       2026-06-16-Feat-portable-engine-universal-vocab. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\data\engine\units.json">
      <LogicalName>MathCursor.Engine.data.units.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\data\engine\cultures.json">
      <LogicalName>MathCursor.Engine.data.cultures.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\data\engine\symbols.json">
      <LogicalName>MathCursor.Engine.data.symbols.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
