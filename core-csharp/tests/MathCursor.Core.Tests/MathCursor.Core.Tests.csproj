<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MathCursor.Core.Tests</RootNamespace>
    <AssemblyName>MathCursor.Core.Tests</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MathCursor.Core\MathCursor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures partagées — les tests les lisent au runtime -->
    <None Include="..\..\..\specs\test-fixtures\*.json" CopyToOutputDirectory="PreserveNewest" Link="fixtures\%(Filename)%(Extension)" />
    <None Include="corpus\*.txt" CopyToOutputDirectory="PreserveNewest" Link="corpus\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
