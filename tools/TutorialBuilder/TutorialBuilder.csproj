<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MathCursor.TutorialBuilder</RootNamespace>
    <AssemblyName>MathCursor.TutorialBuilder</AssemblyName>
    <Description>Génère le tutoriel MathCursor au format Word .docx depuis tutorial-spec.json. Cf. ADR 2026-05-22-Feat-tutorial-docx-generated-onboarding.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tutorial-spec.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
