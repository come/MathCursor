<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MathCursor.TutorialBuilder.Tests</RootNamespace>
    <AssemblyName>MathCursor.TutorialBuilder.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TutorialBuilder\TutorialBuilder.csproj" />
    <ProjectReference Include="..\..\core-csharp\src\MathCursor.Core\MathCursor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lien direct vers la spec du builder pour le test anti-stale -->
    <None Include="..\TutorialBuilder\tutorial-spec.*.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
