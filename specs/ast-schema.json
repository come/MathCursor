{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MathCursor AST Schema",
  "description": "Schéma normatif de l'AST math produit par le parser. Source de vérité pour toute implémentation du core (C# phase 1, TS phase 2).",
  "definitions": {
    "MathNode": {
      "oneOf": [
        { "$ref": "#/definitions/Number" },
        { "$ref": "#/definitions/Variable" },
        { "$ref": "#/definitions/BinaryOp" },
        { "$ref": "#/definitions/Fraction" },
        { "$ref": "#/definitions/Superscript" },
        { "$ref": "#/definitions/Paren" },
        { "$ref": "#/definitions/Juxtaposition" }
      ]
    },
    "Number": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "number" },
        "value": { "type": "string" }
      }
    },
    "Variable": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "variable" },
        "name": { "type": "string" }
      }
    },
    "BinaryOp": {
      "type": "object",
      "required": ["kind", "op", "left", "right"],
      "properties": {
        "kind": { "const": "binop" },
        "op": { "type": "string", "enum": ["+", "-", "*", "/", "=", "<", ">", "<=", ">=", "!="] },
        "left": { "$ref": "#/definitions/MathNode" },
        "right": { "$ref": "#/definitions/MathNode" }
      }
    },
    "Fraction": {
      "type": "object",
      "required": ["kind", "num", "den"],
      "properties": {
        "kind": { "const": "frac" },
        "num": { "$ref": "#/definitions/MathNode" },
        "den": { "$ref": "#/definitions/MathNode" }
      }
    },
    "Superscript": {
      "type": "object",
      "required": ["kind", "base", "exp"],
      "properties": {
        "kind": { "const": "sup" },
        "base": { "$ref": "#/definitions/MathNode" },
        "exp": { "$ref": "#/definitions/MathNode" }
      }
    },
    "Paren": {
      "type": "object",
      "required": ["kind", "open", "inner"],
      "properties": {
        "kind": { "const": "paren" },
        "open": { "type": "string", "enum": ["(", "["] },
        "inner": { "$ref": "#/definitions/MathNode" }
      }
    },
    "Juxtaposition": {
      "type": "object",
      "required": ["kind", "parts"],
      "properties": {
        "kind": { "const": "juxt" },
        "parts": { "type": "array", "items": { "$ref": "#/definitions/MathNode" }, "minItems": 2 }
      }
    }
  },
  "$ref": "#/definitions/MathNode"
}
