<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Trim OFF : [JSExport] est atteint par l'interop runtime ; on garde aussi
         le moteur entier (minuscule). Le poids du bundle = runtime .NET de toute
         façon (cf. web-demo). -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- LE moteur forest — pur, netstandard2.0, zéro dépendance. Exactement le
         même Analyze que Word et que la démo WASM. -->
    <ProjectReference Include="..\..\engine\src\MathCursor.Engine\MathCursor.Engine.csproj" />
  </ItemGroup>
</Project>
