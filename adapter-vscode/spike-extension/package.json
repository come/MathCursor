{
  "name": "mathcursor-spike",
  "displayName": "MathCursor (spike prerender)",
  "description": "Spike jetable : teste le rendu d'un SVG de formule dans le widget de completion natif VSCode.",
  "version": "0.0.1",
  "engines": { "vscode": "^1.90.0" },
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "mathcursor.spikeHello", "title": "MathCursor Spike: Hello" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
