{
  "name": "mathcursor-spike-native",
  "displayName": "MathCursor (spike native popup)",
  "description": "Spike jetable : popup WPF native au caret via helper exe (MSAA).",
  "version": "0.0.1",
  "publisher": "mathcursor",
  "engines": { "vscode": "^1.90.0" },
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "mcNative.show", "title": "MC Native: popup au caret" }
    ],
    "keybindings": [
      {
        "command": "mcNative.show",
        "key": "ctrl+alt+space",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": { "compile": "tsc -p ./" },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
