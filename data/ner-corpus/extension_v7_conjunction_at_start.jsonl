{"text": "et g(x)=rac(x+1)", "spans": [{"start": 3, "end": 16, "label": "MATH"}], "lang": "fr"}
{"text": "et f(x)=2x+1", "spans": [{"start": 3, "end": 12, "label": "MATH"}], "lang": "fr"}
{"text": "et h(x)=cos(x)", "spans": [{"start": 3, "end": 14, "label": "MATH"}], "lang": "fr"}
{"text": "et u_n=2n+1", "spans": [{"start": 3, "end": 11, "label": "MATH"}], "lang": "fr"}
{"text": "et x^2 >= 0", "spans": [{"start": 3, "end": 11, "label": "MATH"}], "lang": "fr"}
{"text": "et 1/n converge vers 0", "spans": [{"start": 3, "end": 6, "label": "MATH"}, {"start": 21, "end": 22, "label": "MATH"}], "lang": "fr"}
{"text": "donc x^2 >= 0", "spans": [{"start": 5, "end": 13, "label": "MATH"}], "lang": "fr"}
{"text": "donc f(x) = 2x", "spans": [{"start": 5, "end": 14, "label": "MATH"}], "lang": "fr"}
{"text": "or n+1 > n", "spans": [{"start": 3, "end": 10, "label": "MATH"}], "lang": "fr"}
{"text": "or u_n converge", "spans": [{"start": 3, "end": 6, "label": "MATH"}], "lang": "fr"}
{"text": "alors u_n=2n+1", "spans": [{"start": 6, "end": 14, "label": "MATH"}], "lang": "fr"}
{"text": "alors f(0)=1", "spans": [{"start": 6, "end": 12, "label": "MATH"}], "lang": "fr"}
{"text": "puis g(t)=sin(t)", "spans": [{"start": 5, "end": 16, "label": "MATH"}], "lang": "fr"}
{"text": "puis f(x)=x^2", "spans": [{"start": 5, "end": 13, "label": "MATH"}], "lang": "fr"}
{"text": "où f(x)=ln(x)", "spans": [{"start": 3, "end": 13, "label": "MATH"}], "lang": "fr"}
{"text": "ainsi x^2+y^2=1", "spans": [{"start": 6, "end": 15, "label": "MATH"}], "lang": "fr"}
{"text": "ainsi pour tout x in R, f(x)>0", "spans": [{"start": 6, "end": 30, "label": "MATH"}], "lang": "fr"}
{"text": "et g(x)=sqrt(x+1)", "spans": [{"start": 3, "end": 17, "label": "MATH"}], "lang": "fr"}
{"text": "et g(x)=racine(x+1)", "spans": [{"start": 3, "end": 19, "label": "MATH"}], "lang": "fr"}
{"text": "et g(x)=frac 1 x", "spans": [{"start": 3, "end": 16, "label": "MATH"}], "lang": "fr"}
{"text": "et g(x)=lim x 0 sin x / x", "spans": [{"start": 3, "end": 25, "label": "MATH"}], "lang": "fr"}
{"text": "et u(x,y)=x^2+y^2", "spans": [{"start": 3, "end": 17, "label": "MATH"}], "lang": "fr"}
{"text": "et v=2u+w", "spans": [{"start": 3, "end": 9, "label": "MATH"}], "lang": "fr"}
{"text": "et A(1,2)", "spans": [{"start": 3, "end": 9, "label": "MATH"}], "lang": "fr"}
{"text": "et vec u (1 2)", "spans": [{"start": 3, "end": 14, "label": "MATH"}], "lang": "fr"}
{"text": "et P=Q+R", "spans": [{"start": 3, "end": 8, "label": "MATH"}], "lang": "fr"}
{"text": "et z=x+iy", "spans": [{"start": 3, "end": 9, "label": "MATH"}], "lang": "fr"}
{"text": "donc f'(x) = 2x", "spans": [{"start": 5, "end": 15, "label": "MATH"}], "lang": "fr"}
{"text": "donc cos(x)^2+sin(x)^2=1", "spans": [{"start": 5, "end": 24, "label": "MATH"}], "lang": "fr"}
{"text": "or pour tout n in N, u_n >= 0", "spans": [{"start": 3, "end": 29, "label": "MATH"}], "lang": "fr"}
{"text": "alors h(x)=exp(x)", "spans": [{"start": 6, "end": 17, "label": "MATH"}], "lang": "fr"}
{"text": "puis on a u_0 = 1", "spans": [{"start": 10, "end": 17, "label": "MATH"}], "lang": "fr"}
{"text": "et h(x) = sqrt(x+1)", "spans": [{"start": 3, "end": 19, "label": "MATH"}], "lang": "fr"}
{"text": "and g(x)=sqrt(x+1)", "spans": [{"start": 4, "end": 18, "label": "MATH"}], "lang": "en"}
{"text": "and f(x)=2x+1", "spans": [{"start": 4, "end": 13, "label": "MATH"}], "lang": "en"}
{"text": "so x^2 >= 0", "spans": [{"start": 3, "end": 11, "label": "MATH"}], "lang": "en"}
{"text": "then f(0)=1", "spans": [{"start": 5, "end": 11, "label": "MATH"}], "lang": "en"}
{"text": "also u_n = n+1", "spans": [{"start": 5, "end": 14, "label": "MATH"}], "lang": "en"}
{"text": "thus a^2 + b^2 = c^2", "spans": [{"start": 5, "end": 20, "label": "MATH"}], "lang": "en"}
