{
  "_comment": "Données universelles — TABLE DES SYMBOLES. Source unique C#/Python. Templates de rendu : placeholders {0}..{5}, substitution SINGLE-PASS (regex), accolades littérales conservées. renderHook = logique conditionnelle (registre C#/Python) : frac_or_setminus, neg, pos, unit, deco(wide,narrow). variants.acceptGuard = registre de guards : tight_body_0, non_numeric_1, name_atom_tail. sameAs = clone d'une autre entrée (+ overrides). looseness par nom (const.looseness). Cf. ADR 2026-06-16-Feat-portable-engine-universal-vocab.",
  "const": {
    "looseness": { "REL": 5, "SUM": 3, "QUANT": 2.5, "PROD": 2, "POW": 1, "APP": 0 }
  },
  "splittable": [
    "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota",
    "kappa", "lambda", "mu", "nu", "xi", "omicron", "pi", "rho", "sigma", "tau",
    "upsilon", "phi", "chi", "psi", "omega",
    "cos", "sin", "tan", "arcsin", "arccos", "arctan", "ln", "log", "exp",
    "vec", "conj"
  ],
  "symbols": {
    "alpha":   { "shape": "atom", "lower": "\\alpha ",   "upper": "\\alpha " },
    "beta":    { "shape": "atom", "lower": "\\beta ",    "upper": "\\beta " },
    "gamma":   { "shape": "atom", "lower": "\\gamma ",   "upper": "\\Gamma " },
    "delta":   { "shape": "atom", "lower": "\\delta ",   "upper": "\\Delta " },
    "epsilon": { "shape": "atom", "lower": "\\epsilon ", "upper": "\\epsilon " },
    "zeta":    { "shape": "atom", "lower": "\\zeta ",    "upper": "\\zeta " },
    "eta":     { "shape": "atom", "lower": "\\eta ",     "upper": "\\eta " },
    "theta":   { "shape": "atom", "lower": "\\theta ",   "upper": "\\Theta " },
    "iota":    { "shape": "atom", "lower": "\\iota ",    "upper": "\\iota " },
    "kappa":   { "shape": "atom", "lower": "\\kappa ",   "upper": "\\kappa " },
    "lambda":  { "shape": "atom", "lower": "\\lambda ",  "upper": "\\Lambda " },
    "mu":      { "shape": "atom", "lower": "\\mu ",      "upper": "\\mu " },
    "nu":      { "shape": "atom", "lower": "\\nu ",      "upper": "\\nu " },
    "xi":      { "shape": "atom", "lower": "\\xi ",      "upper": "\\Xi " },
    "omicron": { "shape": "atom", "lower": "\\omicron ", "upper": "\\omicron " },
    "pi":      { "shape": "atom", "lower": "\\pi ",      "upper": "\\Pi " },
    "rho":     { "shape": "atom", "lower": "\\rho ",     "upper": "\\rho " },
    "sigma":   { "shape": "atom", "lower": "\\sigma ",   "upper": "\\Sigma " },
    "tau":     { "shape": "atom", "lower": "\\tau ",     "upper": "\\tau " },
    "upsilon": { "shape": "atom", "lower": "\\upsilon ", "upper": "\\Upsilon " },
    "phi":     { "shape": "atom", "lower": "\\phi ",     "upper": "\\Phi " },
    "chi":     { "shape": "atom", "lower": "\\chi ",     "upper": "\\chi " },
    "psi":     { "shape": "atom", "lower": "\\psi ",     "upper": "\\Psi " },
    "omega":   { "shape": "atom", "lower": "\\omega ",   "upper": "\\Omega " },

    "R": { "shape": "atom", "alts": ["R", "\\mathbb{R} "], "coh": "set" },
    "N": { "shape": "atom", "alts": ["N", "\\mathbb{N} "], "coh": "set" },
    "Z": { "shape": "atom", "alts": ["Z", "\\mathbb{Z} "], "coh": "set" },
    "Q": { "shape": "atom", "alts": ["Q", "\\mathbb{Q} "], "coh": "set" },
    "C": { "shape": "atom", "alts": ["C", "\\mathbb{C} "], "coh": "set" },

    "·unit": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "APP", "unitOp": true, "renderHook": "unit" },

    "+": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0}+{1}", "unary": "pos", "postSign": "+" },
    "-": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0}-{1}", "unary": "neg", "postSign": "-" },
    "*": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "implicit": true, "render": "{0}\\times {1}", "renderImplicit": "{0}{1}", "postSign": "\\ast " },
    "·apply": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "APP", "apply": true, "render": "{0}{1}" },
    ".": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "render": "{0}\\cdot {1}" },
    "/": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "bracketed": true, "renderHook": "frac_or_setminus" },
    "^": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "POW", "sup": true, "render": "{0}^{{1}}", "unary": "hat" },
    "_": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "POW", "sub": true, "render": "{0}_{{1}}" },

    "!": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}!" },
    "'": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}'" },
    "%": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}\\%" },
    "°": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}^{\\circ}" },
    "°C": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}^{\\circ}\\mathrm{C}" },
    "°F": { "shape": "postfix", "class": "STRONG", "looseness": "POW", "render": "{0}^{\\circ}\\mathrm{F}" },

    "~":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\sim {1}" },
    "=":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}={1}" },
    "<":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}<{1}" },
    ">":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}>{1}" },
    "!=": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\neq {1}" },
    ">=": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\geq {1}" },
    "<=": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\leq {1}" },
    "->": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "mapping": true, "render": "{0}\\to {1}" },

    ":": { "shape": "infix", "alts": ["·div", "·colon"] },
    "·div":   { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "render": "{0}\\div {1}" },
    "·colon": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\colon {1}" },
    "·mid":   { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\mid {1}" },

    "neg": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "renderHook": "neg" },
    "pos": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "renderHook": "pos" },

    "cos":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\cos({0})" },
    "sin":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\sin({0})" },
    "tan":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\tan({0})" },
    "arcsin": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\arcsin({0})" },
    "arccos": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\arccos({0})" },
    "arctan": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\arctan({0})" },
    "ln":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\ln({0})" },
    "log":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\log({0})" },
    "sinh":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\sinh({0})" },
    "cosh":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\cosh({0})" },
    "tanh":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\tanh({0})" },
    "coth":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\coth({0})" },
    "exp":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "e^{{0}}" },
    "arg":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\arg({0})" },
    "Re":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\operatorname{Re}({0})" },
    "Im":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\operatorname{Im}({0})" },
    "bar":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "tight": true, "renderHook": "deco", "hookParams": { "wide": "overline", "narrow": "bar" } },
    "vec":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "tight": true, "renderHook": "deco", "hookParams": { "wide": "overrightarrow", "narrow": "vec" } },
    "hat":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "tight": true, "renderHook": "deco", "hookParams": { "wide": "widehat", "narrow": "hat" } },
    "norm":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\left\\|{0}\\right\\|" },
    "abs":    { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\left|{0}\\right|" },
    "sqrt":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\sqrt{{0}}" },
    "root":   { "shape": "nary", "arity": 2, "class": "STRONG", "looseness": "APP", "render": "\\sqrt[{0}]{{1}}" },
    "floor":  { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\lfloor {0}\\rfloor " },
    "ceil":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\lceil {0}\\rceil " },
    "pgcd":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\operatorname{pgcd}({0})" },
    "ppcm":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\operatorname{ppcm}({0})" },

    "forall":  { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "list": true, "render": "\\forall {0}" },
    "exists":  { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "list": true, "render": "\\exists {0}" },
    "nexists": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "list": true, "render": "\\nexists {0}" },
    "not":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "list": true, "render": "\\neg {0}" },

    "in":        { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\in {1}" },
    "notin":     { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\notin {1}" },
    "subset":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\subset {1}" },
    "subseteq":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\subseteq {1}" },
    "supset":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\supset {1}" },
    "supseteq":  { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\supseteq {1}" },
    "notsubset": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\not\\subset {1}" },
    "and":       { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\wedge {1}" },
    "or":        { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\vee {1}" },
    "equiv":     { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\equiv {1}" },
    "cong":      { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\cong {1}" },
    "approx":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\approx {1}" },
    "propto":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "render": "{0}\\propto {1}" },

    "union":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM",  "render": "{0}\\cup {1}" },
    "inter":    { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "PROD", "render": "{0}\\cap {1}" },
    "setminus": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM",  "render": "{0}\\setminus {1}" },

    "emptyset": { "shape": "atom", "lower": "\\emptyset ", "upper": "\\emptyset " },
    "inf":      { "shape": "atom", "lower": "\\infty ",    "upper": "\\infty " },
    "dots":     { "shape": "atom", "lower": "\\ldots ",    "upper": "\\ldots " },
    "cdots":    { "shape": "atom", "lower": "\\cdots ",    "upper": "\\cdots " },
    "vdots":    { "shape": "atom", "lower": "\\vdots ",    "upper": "\\vdots " },
    "ddots":    { "shape": "atom", "lower": "\\ddots ",    "upper": "\\ddots " },

    "partial": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "tight": true, "render": "\\partial {0}" },
    "nabla":   { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "tight": true, "render": "\\nabla {0}" },
    "det":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\det {0}" },
    "dim":     { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\dim {0}" },
    "dot":     { "shape": "nary", "arity": 2, "class": "STRONG", "looseness": "APP", "render": "\\langle {0},{1}\\rangle " },

    "lim":  { "shape": "nary", "arity": 3, "class": "STRONG", "looseness": "QUANT", "render": "\\lim_{{0}\\to {1}} {2}",
              "variants": [ { "arity": 1, "render": "\\lim {0}", "acceptGuard": "tight_body_0" } ] },
    "sum":  { "shape": "nary", "arity": 4, "class": "STRONG", "looseness": "QUANT", "render": "\\sum_{{0}={1}}^{{2}} {3}",
              "variants": [ { "arity": 2, "render": "\\sum_{{0}} {1}", "acceptGuard": "non_numeric_1" } ] },
    "prod": { "shape": "nary", "arity": 4, "class": "STRONG", "looseness": "QUANT", "render": "\\prod_{{0}={1}}^{{2}} {3}",
              "variants": [ { "arity": 2, "render": "\\prod_{{0}} {1}", "acceptGuard": "non_numeric_1" } ] },
    "int":  { "shape": "nary", "arity": 4, "class": "STRONG", "looseness": "QUANT", "render": "\\int_{{0}}^{{1}} {2} \\, d{3}",
              "variants": [ { "arity": 2, "render": "\\int {0} \\, d{1}", "acceptGuard": "name_atom_tail" } ] },
    "iint": { "shape": "nary", "arity": 5, "class": "STRONG", "looseness": "QUANT", "render": "\\iint_{{0}}^{{1}} {2} \\, d{3}\\,d{4}",
              "variants": [ { "arity": 3, "render": "\\iint {0} \\, d{1}\\,d{2}", "acceptGuard": "name_atom_tail" } ] },
    "iiint":{ "shape": "nary", "arity": 6, "class": "STRONG", "looseness": "QUANT", "render": "\\iiint_{{0}}^{{1}} {2} \\, d{3}\\,d{4}\\,d{5}",
              "variants": [ { "arity": 4, "render": "\\iiint {0} \\, d{1}\\,d{2}\\,d{3}", "acceptGuard": "name_atom_tail" } ] },
    "binom": { "shape": "nary", "arity": 2, "class": "STRONG", "looseness": "APP", "render": "\\binom{{0}}{{1}}" },
    "·parmi": { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "bracketed": true, "render": "\\binom{{1}}{{0}}" },

    "mod":      { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "render": "{0} \\bmod {1}" },
    "perp":     { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0} \\perp {1}" },
    "circ":     { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": "PROD", "render": "{0}\\circ {1}" },
    "pm":       { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0}\\pm {1}", "unary": "upm" },
    "mp":       { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0}\\mp {1}", "unary": "ump" },
    "upm":      { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\pm {0}" },
    "ump":      { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": "APP", "render": "\\mp {0}" },
    "parallel": { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "SUM", "render": "{0} \\mathbin{/\\!/} {1}" },
    "mapsto":   { "shape": "infix", "arity": 2, "class": "WEAK", "looseness": "REL", "cut": true, "mapping": true, "render": "{0}\\mapsto {1}" },

    "·greek-t": { "shape": "atom", "alts": ["\\theta ", "\\tau "], "altsUpper": ["\\Theta "] },
    "·greek-e": { "shape": "atom", "alts": ["\\epsilon ", "\\eta "] },
    "·greek-p": { "shape": "atom", "alts": ["\\pi ", "\\phi ", "\\varphi ", "\\psi "], "altsUpper": ["\\Pi ", "\\Phi ", "\\Psi "] },

    "·forallWord": { "sameAs": "forall", "wordSpace": true },
    "//": { "sameAs": "parallel" },
    "**": { "sameAs": "^" },
    "+-": { "sameAs": "pm" },
    "-+": { "sameAs": "mp" },
    "≤": { "sameAs": "<=" },
    "≥": { "sameAs": ">=" },
    "≠": { "sameAs": "!=" },
    "≈": { "sameAs": "approx" },
    "×": { "sameAs": "*" },
    "÷": { "sameAs": "·div" },
    "∘": { "sameAs": "circ" },
    "±": { "sameAs": "pm" },
    "·": { "sameAs": "." },
    "...": { "sameAs": "dots" },
    "…": { "sameAs": "dots" },

    "¼": { "shape": "atom", "lower": "\\frac{1}{4}", "upper": "\\frac{1}{4}" },
    "½": { "shape": "atom", "lower": "\\frac{1}{2}", "upper": "\\frac{1}{2}" },
    "¾": { "shape": "atom", "lower": "\\frac{3}{4}", "upper": "\\frac{3}{4}" },
    "⅐": { "shape": "atom", "lower": "\\frac{1}{7}", "upper": "\\frac{1}{7}" },
    "⅑": { "shape": "atom", "lower": "\\frac{1}{9}", "upper": "\\frac{1}{9}" },
    "⅒": { "shape": "atom", "lower": "\\frac{1}{10}", "upper": "\\frac{1}{10}" },
    "⅓": { "shape": "atom", "lower": "\\frac{1}{3}", "upper": "\\frac{1}{3}" },
    "⅔": { "shape": "atom", "lower": "\\frac{2}{3}", "upper": "\\frac{2}{3}" },
    "⅕": { "shape": "atom", "lower": "\\frac{1}{5}", "upper": "\\frac{1}{5}" },
    "⅖": { "shape": "atom", "lower": "\\frac{2}{5}", "upper": "\\frac{2}{5}" },
    "⅗": { "shape": "atom", "lower": "\\frac{3}{5}", "upper": "\\frac{3}{5}" },
    "⅘": { "shape": "atom", "lower": "\\frac{4}{5}", "upper": "\\frac{4}{5}" },
    "⅙": { "shape": "atom", "lower": "\\frac{1}{6}", "upper": "\\frac{1}{6}" },
    "⅚": { "shape": "atom", "lower": "\\frac{5}{6}", "upper": "\\frac{5}{6}" },
    "⅛": { "shape": "atom", "lower": "\\frac{1}{8}", "upper": "\\frac{1}{8}" },
    "⅜": { "shape": "atom", "lower": "\\frac{3}{8}", "upper": "\\frac{3}{8}" },
    "⅝": { "shape": "atom", "lower": "\\frac{5}{8}", "upper": "\\frac{5}{8}" },
    "⅞": { "shape": "atom", "lower": "\\frac{7}{8}", "upper": "\\frac{7}{8}" }
  }
}
