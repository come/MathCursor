      "@m": "mu", "@n": "nu", "@x": "xi", "@o": "omega",
      "@r": "rho", "@s": "sigma", "@u": "upsilon", "@c": "chi",
      "@t": "·greek-t", "@e": "·greek-e", "@p": "·greek-p"
