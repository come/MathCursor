      "neq": "!=", "leq": "<=", "geq": ">=",
      "wedge": "and", "vee": "or", "cdot": ".", "times": "*",
      "varnothing": "emptyset",
      "plusminus": "pm", "angle": "hat",
      "gcd": "pgcd", "lcm": "ppcm",
      "integral": "int", "lmt": "lim",
