<?xml version="1.0" encoding="UTF-8"?>
<!-- Intègre un item de menu Writer appelant convert_selection. NB : l'URI du
     script bundlé dans un .oxt (location) est à VALIDER en conditions réelles ;
     la méthode A (macro déposée dans Scripts/python utilisateur) est plus sûre
     pour les premiers tests. Cf. README. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="fr.mathcursor.libreoffice" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergeContext" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument</value>
          </prop>
          <prop oor:name="MergePoint" oor:type="xs:string">
            <value>.uno:ToolsMenu\.uno:MacrosMenu</value>
          </prop>
          <prop oor:name="MergeCommand" oor:type="xs:string"><value>AddAfter</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>vnd.sun.star.script:MathCursor.oxt|Scripts|python|mathcursor.py$convert_selection?language=Python&amp;location=user:uno_packages</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="fr">MathCursor : convertir la sélection</value>
                <value xml:lang="en">MathCursor: convert selection</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
            <node oor:name="M2" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>vnd.sun.star.script:MathCursor.oxt|Scripts|python|mathcursor.py$autodetect_start?language=Python&amp;location=user:uno_packages</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="fr">MathCursor : activer l'auto-détection</value>
                <value xml:lang="en">MathCursor: enable auto-detection</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
            <node oor:name="M3" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>vnd.sun.star.script:MathCursor.oxt|Scripts|python|mathcursor.py$autodetect_stop?language=Python&amp;location=user:uno_packages</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="fr">MathCursor : désactiver l'auto-détection</value>
                <value xml:lang="en">MathCursor: disable auto-detection</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
            <node oor:name="M4" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>vnd.sun.star.script:MathCursor.oxt|Scripts|python|mathcursor.py$about?language=Python&amp;location=user:uno_packages</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="fr">MathCursor : à propos / licence</value>
                <value xml:lang="en">MathCursor: about / license</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
