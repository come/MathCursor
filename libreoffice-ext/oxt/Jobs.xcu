<?xml version="1.0" encoding="UTF-8"?>
<!-- Lie le Job AutoStartJob aux événements d'ouverture de document (OnLoad =
     document existant, OnNew = nouveau, OnViewCreated = vue prête). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="MathCursorAutoStart" oor:op="replace">
      <prop oor:name="Service" oor:type="xs:string">
        <value>fr.mathcursor.AutoStartJob</value>
      </prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="OnLoad" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="MathCursorAutoStart" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnNew" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="MathCursorAutoStart" oor:op="replace"/>
      </node>
    </node>
    <node oor:name="OnViewCreated" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="MathCursorAutoStart" oor:op="replace"/>
      </node>
    </node>
  </node>
</oor:component-data>
