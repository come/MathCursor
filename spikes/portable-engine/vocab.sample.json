{
  "_comment": "SPIKE jetable (P0) — échantillon du format universel de vocabulaire. Mini-langage de template: {0}/{1} = args rendus; les accolades littérales restent telles quelles. renderHook = logique nommée portée par langage (les 3 rendus conditionnels). Valeurs (looseness, MUL) copiées de Vocabulary.cs.",
  "const": { "MUL": "\\times ", "looseness": { "REL": 5, "SUM": 3, "QUANT": 2.5, "PROD": 2, "POW": 1, "APP": 0 } },
  "cultures": {
    "fr": { "decimalTex": "{,}", "intervalSep": ";", "matrixEnv": "pmatrix" },
    "us": { "decimalTex": ".",  "intervalSep": ",", "matrixEnv": "bmatrix" }
  },
  "symbols": {
    "pi":   { "shape": "atom", "lower": "\\pi ", "upper": "\\pi " },
    "cos":  { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": 0, "render": "\\cos({0})" },
    "sqrt": { "shape": "prefix", "arity": 1, "class": "STRONG", "looseness": 0, "render": "\\sqrt{{0}}" },
    "+":    { "shape": "infix", "arity": 2, "class": "WEAK",   "looseness": 3, "render": "{0}+{1}" },
    "*":    { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": 2, "implicit": true, "render": "{0}\\times {1}", "renderImplicit": "{0}{1}" },
    "/":    { "shape": "infix", "arity": 2, "class": "WEAK",   "looseness": 2, "bracketed": true, "renderHook": "frac_or_setminus", "render": "\\frac{{0}}{{1}}" },
    "^":    { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": 1, "sup": true, "render": "{0}^{{1}}" },
    "_":    { "shape": "infix", "arity": 2, "class": "STRONG", "looseness": 1, "sub": true, "render": "{0}_{{1}}" }
  }
}
